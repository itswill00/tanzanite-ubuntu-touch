# --- LEDs, torch and haptics -------------------------------------------------
# Ubuntu Touch userspace runs as the `phablet` user; the sysfs nodes below are
# created by leds-mtk / leds-mtk-pwm / flashlight / regulator-vibrator and are
# root-owned by default, so the desktop cannot drive them without these rules.

# Notification LED (deviceinfo SingleColorLedSysfsPath=/sys/class/leds/green)
ACTION=="add|change", SUBSYSTEM=="leds", KERNEL=="green", OWNER="system", GROUP="system", MODE="0660"
ACTION=="add|change", SUBSYSTEM=="leds", KERNEL=="red",   OWNER="system", GROUP="system", MODE="0660"
ACTION=="add|change", SUBSYSTEM=="leds", KERNEL=="blue",  OWNER="system", GROUP="system", MODE="0660"

# Flashlight / torch. The MTK driver registers class `flashlight_core`, which
# produces /sys/class/flashlight_core/flashlight/flashlight_torch - the exact path
# tanzanite-flashlight-bridge writes to on behalf of ayatana-indicator-power
# (deviceinfo FlashlightSysfsPath=/run/flashlight_bridge). Cover the generic
# `leds` and `flashlight` classes too, since the node name varies by kernel.
ACTION=="add|change", SUBSYSTEM=="leds", KERNEL=="*flash*", OWNER="system", GROUP="system", MODE="0660"
ACTION=="add|change", SUBSYSTEM=="flashlight_core", KERNEL=="*", OWNER="system", GROUP="system", MODE="0660"
ACTION=="add|change", SUBSYSTEM=="flashlight", KERNEL=="*", OWNER="system", GROUP="system", MODE="0660"
ACTION=="add|change", KERNEL=="flashlight_torch", OWNER="system", GROUP="system", MODE="0660"

# Haptics. hfd-service probes, in order: binder AIDL/HIDL vibrator, then
# /sys/class/leds/vibrator (VibratorSysfs), then /sys/class/timed_output/vibrator
# (VibratorLegacy), then force-feedback input devices. regulator-vibrator on
# MT6789 registers a timed_output device, so VibratorLegacy is the path that
# actually gets used here - it must be writable or hfd-service silently falls
# back to VibratorDummy and no haptics happen at all.
ACTION=="add|change", SUBSYSTEM=="timed_output", KERNEL=="*", OWNER="system", GROUP="system", MODE="0660"
ACTION=="add|change", KERNEL=="timed_output*", OWNER="system", GROUP="system", MODE="0660"
# leds-class vibrator, in case a different kernel config exposes it that way
ACTION=="add|change", SUBSYSTEM=="leds", KERNEL=="vibrator", OWNER="system", GROUP="system", MODE="0660"
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="*vibrator*", OWNER="system", GROUP="system", MODE="0660"

# Display backlight, used by repowerd/ayatana for brightness control.
ACTION=="add|change", SUBSYSTEM=="backlight", KERNEL=="*", OWNER="system", GROUP="system", MODE="0660"
