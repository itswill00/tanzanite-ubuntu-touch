#!/sbin/sh
DIR="$(cd "$(dirname "$0")" && pwd)"
OUT=""
IMG=""
while [ $# -gt 0 ]; do
  case "$1" in
    -x|-o)
      OUT="$2"
      shift 2
      ;;
    --extract=*)
      OUT="${1#--extract=}"
      shift
      ;;
    -i)
      IMG="$2"
      shift 2
      ;;
    *)
      IMG="$1"
      shift
      ;;
  esac
done
exec "$DIR/fsck.erofs" --extract="$OUT" --preserve --overwrite "$IMG"
